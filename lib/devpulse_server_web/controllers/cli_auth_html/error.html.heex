<div class="min-h-[70vh] flex items-center justify-center px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full text-center bg-white p-8 rounded-xl shadow-lg border border-red-100">
    <div class="mx-auto h-12 w-12 flex items-center justify-center rounded-full bg-red-100 text-red-600 mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
      </svg>
    </div>
    
    <h2 class="text-2xl font-bold text-gray-900">Authorization Failed</h2>
    <p class="mt-2 text-sm text-gray-600">
      <%= assigns[:message] || "This authorization link is invalid or has expired." %>
    </p>

    <div class="mt-6 pt-6 border-t border-gray-100">
      <p class="text-xs text-gray-400">
        Please re-run the setup command in your CLI to request a fresh authorization link.
      </p>
    </div>
  </div>
</div>