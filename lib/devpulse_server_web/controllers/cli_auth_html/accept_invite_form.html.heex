<div class="mx-auto max-w-md mt-12 p-8 bg-white rounded-xl shadow-md border border-slate-200">
  <div class="text-center mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Accept Your Invite</h1>
    <p class="text-sm text-slate-500 mt-1">Set up your developer profile to authorize CLI access.</p>
  </div>

  <%= if assigns[:error_message] do %>
    <div class="mb-4 p-3 bg-red-50 text-red-700 text-sm rounded-lg border border-red-200">
      <%= @error_message %>
    </div>
  <% end %>

  <.form for={%{}} action={~p"/api/v1/cli/auth/accept"} method="post" class="space-y-5">
    <%!-- Form input names match your controller payload exactly --%>
    <input type="hidden" name="invite_token" value={@token} />


    <div>
      <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">
        Email Address
      </label>
      <input
        type="email"
        value={@invite.email}
        disabled
        class="w-full px-3 py-2 bg-slate-100 border border-slate-300 rounded-lg text-slate-500 cursor-not-allowed font-medium text-sm"
      />
    </div>

    <div>
      <label for="name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
        Full Name
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        placeholder="e.g. Jane Doe"
        class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-900 text-sm"
      />
    </div>

    <div>
      <label for="avatar_url" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
        Avatar Style
      </label>
      <select
        id="avatar_url"
        name="avatar_url"
        class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-900 text-sm bg-white"
      >
        <option value={"https://api.dicebear.com/7.x/bottts/svg?seed=#{@invite.email}"}>Bottts (Robot)</option>
        <option value={"https://api.dicebear.com/7.x/avataaars/svg?seed=#{@invite.email}"}>Avataaars (Human)</option>
        <option value={"https://api.dicebear.com/7.x/identicon/svg?seed=#{@invite.email}"}>Identicon (Abstract)</option>
      </select>
    </div>

    <button
      type="submit"
      class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm rounded-lg transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
    >
      Accept Invite & Authorize CLI
    </button>
  </.form>
</div>