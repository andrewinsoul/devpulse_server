<div class="min-h-[70vh] flex items-center justify-center px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-lg border border-gray-100">
    <div class="text-center">
      <div class="mx-auto h-12 w-12 flex items-center justify-center rounded-full bg-indigo-100 text-indigo-600 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z" />
        </svg>
      </div>
      <h2 class="text-2xl font-extrabold text-gray-900 tracking-tight">Authorize DevPulse CLI</h2>
      <p class="mt-2 text-sm text-gray-500">
        A local terminal session is requesting permissions to access your account credentials.
      </p>
    </div>

    <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 text-xs font-mono text-slate-600 space-y-1">
      <div class="flex justify-between">
        <span class="text-slate-400">Request Type:</span>
        <span class="font-semibold text-slate-700">CLI Verification</span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Pairing Code:</span>
        <span class="font-semibold text-indigo-600"><%= String.slice(@pairing_code, 0..12) %>...</span>
      </div>
    </div>

    <.form :let={_f} for={%{}} action={~p"/api/v1/cli/auth/verify"} method="post" class="mt-6 space-y-4">
      <input type="hidden" name="code" value={@pairing_code} />

      <button
        type="submit"
        class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors"
      >
        Confirm & Connect Terminal
      </button>
    </.form>

    <p class="text-center text-xs text-gray-400 mt-4">
      If you did not initiate this request from your terminal, you can safely close this window.
    </p>
  </div>
</div>